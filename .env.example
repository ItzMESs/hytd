# Vercel injects this automatically once you add a Postgres integration
# (e.g. "Prisma Postgres" during Deploy, or from the Storage tab/Marketplace
# afterwards) and connect it to this project — you normally do NOT need to
# set it by hand on Vercel. For local development, or a different Postgres
# provider used directly, copy this file to .env and fill in your own
# connection string.
DATABASE_URL="postgres://user:password@host:5432/dbname?sslmode=require"

# Required by NextAuth. Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# Needed for local development. On Vercel this isn't strictly required —
# next.config.js falls back to the deployment's own VERCEL_URL if it's
# unset — but setting it explicitly to your project's real domain (e.g.
# https://your-project.vercel.app) is still recommended for production,
# so auth callbacks always point at your stable domain, not a per-deploy one.
NEXTAUTH_URL="http://localhost:3000"
