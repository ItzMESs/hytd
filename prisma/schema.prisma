generator client {
  provider = "prisma-client-js"
}

// Works with any Postgres integration Vercel offers during deploy/in the
// Marketplace (Prisma Postgres, Neon, Supabase, ...) — they all set
// DATABASE_URL automatically once connected to this project. Only one
// connection string is required, so this stays compatible across providers
// (some, like Neon, also set a separate "unpooled" var for migrations, but
// it isn't required here). For local development, or a provider outside
// Vercel, copy .env.example to .env and fill in your own connection string.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  progress     Progress?
}

// One row per user. `data` holds the full SRS/progress JSON blob exactly as
// the client builds it (cards, quiz history, bookmarks, notes, ...).
// nickname/challenge/mastered/learned/streak are duplicated as plain columns
// so the leaderboard can be queried and sorted without unpacking the JSON.
model Progress {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  data        Json
  nickname    String   @default("")
  challenge   String   @default("")
  avatarEmoji String   @default("")
  mastered    Int      @default(0)
  learned     Int      @default(0)
  streak      Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@index([mastered])
}
